{
  "name": "thomaspwilson",
  "version": "1.0.0",
  "private": true,
  "description": "My Gatsby site",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "npx --node-arg '-r esm' gatsby develop -H 0.0.0.0",
    "start": "npx --node-arg '-r esm' npm run develop",
    "build": "npx --node-arg '-r esm' gatsby build",
    "serve": "npx --node-arg '-r esm' gatsby serve",
    "clean": "npx --node-arg '-r esm' gatsby clean",
    "test": "jest ."
  },
  "license": "0BSD",
  "dependencies": {
    "classnames": "^2.2.6",
    "gatsby": "2.32.0",
    "gatsby-plugin-portal": "^1.0.7",
    "gatsby-plugin-sass": "^3.2.0",
    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.20",
    "memoize-one": "^5.1.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-mathjax-preview": "^2.1.3",
    "react-router-dom": "^5.2.0",
    "sass": "^1.32.6"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.13.15",
    "esm": "^3.2.25",
    "gatsby-cli": "2.19.0",
    "jest": "^26.6.3"
  }
}
