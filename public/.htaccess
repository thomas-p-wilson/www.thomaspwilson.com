# Apache config for DreamHost shared hosting. Vite copies this file from
# public/ into dist/ unchanged, and the deploy workflow uploads it with the
# rest of the build.

# Single-page app fallback: the React router handles every path in the
# browser, so a request for /projects/gaming has to get index.html too.
# Files and directories that really exist (assets, favicon, ...) are served
# as-is.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # index.html changes on every deploy, so browsers must always recheck it.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Everything under /assets/ has a content hash in its filename, so it can
  # be cached for good.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
